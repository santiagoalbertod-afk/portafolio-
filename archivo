<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Santiago Díaz · Community Manager & Creativo Digital</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--deep:#030d1a;--dark:#071426;--mid:#0a2240;--electric:#0066ff;--bright:#1a8cff;--cyan:#00d4ff;--glow:#4db8ff;--white:#f0f6ff;--dim:rgba(240,246,255,0.6);}
*{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth}
body{background:var(--deep);color:var(--white);font-family:'DM Sans',sans-serif;overflow-x:hidden;cursor:none}
.cursor{width:12px;height:12px;background:var(--cyan);border-radius:50%;position:fixed;top:0;left:0;pointer-events:none;z-index:9999;mix-blend-mode:screen}
.cursor-ring{width:36px;height:36px;border:1px solid var(--electric);border-radius:50%;position:fixed;top:0;left:0;pointer-events:none;z-index:9998;transition:width .2s,height .2s}
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");pointer-events:none;z-index:1;opacity:.5}
nav{position:fixed;top:0;width:100%;padding:20px 48px;display:flex;justify-content:space-between;align-items:center;z-index:100;background:linear-gradient(to bottom,rgba(3,13,26,.97),transparent);backdrop-filter:blur(4px)}
.nav-logo{font-family:'Bebas Neue';font-size:20px;letter-spacing:4px;color:var(--cyan);text-shadow:0 0 20px var(--cyan)}
.nav-links{display:flex;gap:28px}
.nav-links a{font-family:'Space Mono';font-size:10px;letter-spacing:2px;color:var(--dim);text-decoration:none;text-transform:uppercase;transition:color .3s}
.nav-links a:hover{color:var(--cyan)}
.hero{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:120px 48px 80px;position:relative;overflow:hidden;gap:60px}
.hero::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(0,102,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(0,102,255,.06) 1px,transparent 1px);background-size:60px 60px}
.orb{position:absolute;border-radius:50%;filter:blur(80px);pointer-events:none;animation:orbFloat 8s ease-in-out infinite}
.orb1{width:500px;height:500px;background:radial-gradient(circle,rgba(0,102,255,.25),transparent 70%);top:-100px;right:-100px}
.orb2{width:300px;height:300px;background:radial-gradient(circle,rgba(0,212,255,.2),transparent 70%);bottom:100px;left:5%;animation-delay:-3s}
@keyframes orbFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-30px)}}
.hero-content{position:relative;z-index:2}
.hero-tag{font-family:'Space Mono';font-size:10px;letter-spacing:4px;color:var(--cyan);text-transform:uppercase;margin-bottom:20px;display:flex;align-items:center;gap:12px;animation:up .8s ease both}
.hero-tag::before{content:'';display:block;width:32px;height:1px;background:var(--cyan);box-shadow:0 0 8px var(--cyan)}
.hero-name{font-family:'Bebas Neue';font-size:clamp(56px,7vw,100px);line-height:.9;letter-spacing:2px;background:linear-gradient(135deg,#fff 0%,#a8d8ff 40%,var(--cyan) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:up .8s .15s ease both;filter:drop-shadow(0 0 30px rgba(0,212,255,.3))}
.hero-sub{font-size:clamp(14px,1.5vw,18px);font-weight:300;color:var(--dim);margin-top:12px;animation:up .8s .3s ease both}
.hero-sub span{color:var(--bright);font-weight:500}
.hero-desc{font-size:14px;line-height:1.8;color:var(--dim);margin-top:20px;font-weight:300;max-width:480px;animation:up .8s .45s ease both}
/* ARQ BADGE */
.arq-badge{display:inline-flex;align-items:center;gap:10px;margin-top:16px;padding:10px 18px;border:1px solid rgba(0,212,255,.4);background:rgba(0,212,255,.06);animation:up .8s .5s ease both}
.arq-badge-icon{font-size:20px}
.arq-badge-text{font-family:'Space Mono';font-size:9px;letter-spacing:2px;color:var(--cyan);text-transform:uppercase;line-height:1.5}
.arq-badge-text strong{display:block;font-size:11px;letter-spacing:3px}
.hero-ctas{display:flex;gap:14px;margin-top:24px;flex-wrap:wrap;animation:up .8s .6s ease both}
.btn-p{padding:12px 28px;background:var(--electric);color:white;text-decoration:none;font-family:'Space Mono';font-size:11px;letter-spacing:2px;text-transform:uppercase;transition:transform .2s,box-shadow .3s;box-shadow:0 0 30px rgba(0,102,255,.4);cursor:none}
.btn-p:hover{transform:translateY(-2px);box-shadow:0 0 50px rgba(0,212,255,.5)}
.btn-o{padding:12px 28px;background:transparent;color:var(--dim);text-decoration:none;font-family:'Space Mono';font-size:11px;letter-spacing:2px;text-transform:uppercase;border:1px solid rgba(0,102,255,.4);transition:border-color .3s,color .3s;cursor:none}
.btn-o:hover{border-color:var(--cyan);color:var(--cyan)}
.loc-bar{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px;animation:up .8s .75s ease both}
.loc-pill{display:flex;align-items:center;gap:6px;padding:5px 12px;border:1px solid rgba(0,102,255,.3);font-family:'Space Mono';font-size:9px;letter-spacing:1px;color:var(--glow);background:rgba(0,102,255,.06)}
.loc-dot{width:5px;height:5px;background:var(--cyan);border-radius:50%;box-shadow:0 0 8px var(--cyan);animation:pulse 2s ease infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)}}
.photo-wrap{position:relative;z-index:2;display:flex;justify-content:center;align-items:center;animation:up .8s .2s ease both}
.photo-frame{position:relative;width:100%;max-width:400px}
.photo-frame::before{content:'';position:absolute;inset:-2px;background:linear-gradient(135deg,var(--electric),var(--cyan),transparent);z-index:-1;clip-path:polygon(0 0,85% 0,100% 15%,100% 100%,15% 100%,0 85%)}
.hero-photo{width:100%;aspect-ratio:3/4;object-fit:cover;object-position:top;clip-path:polygon(0 0,85% 0,100% 15%,100% 100%,15% 100%,0 85%);filter:grayscale(15%) contrast(1.05)}
.photo-badge{position:absolute;bottom:24px;right:-20px;background:linear-gradient(135deg,var(--electric),var(--bright));padding:14px 18px;box-shadow:0 10px 40px rgba(0,102,255,.4)}
.photo-badge-num{font-family:'Bebas Neue';font-size:34px;line-height:1;color:white}
.photo-badge-lbl{font-family:'Space Mono';font-size:8px;letter-spacing:1px;color:rgba(255,255,255,.8);text-transform:uppercase}
.photo-tag{position:absolute;top:20px;left:-16px;border:1px solid var(--cyan);background:rgba(3,13,26,.9);padding:8px 14px;font-family:'Space Mono';font-size:9px;letter-spacing:2px;color:var(--cyan);text-transform:uppercase}
@keyframes up{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.ticker-wrap{overflow:hidden;border-top:1px solid rgba(0,102,255,.15);border-bottom:1px solid rgba(0,102,255,.15);padding:14px 0;background:rgba(0,102,255,.03)}
.ticker{display:flex;gap:40px;animation:tick 32s linear infinite;white-space:nowrap}
.ticker-item{font-family:'Bebas Neue';font-size:18px;letter-spacing:3px;color:rgba(0,102,255,.5);display:flex;align-items:center;gap:14px}
.ticker-item::after{content:'✦';color:var(--cyan);opacity:.6;font-size:11px}
@keyframes tick{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.stats{background:linear-gradient(90deg,var(--dark),rgba(0,102,255,.08),var(--dark));border-top:1px solid rgba(0,102,255,.2);border-bottom:1px solid rgba(0,102,255,.2);padding:40px 48px;display:flex;justify-content:space-around;align-items:center;flex-wrap:wrap;gap:24px}
.stat{text-align:center}
.stat-num{font-family:'Bebas Neue';font-size:52px;line-height:1;background:linear-gradient(135deg,white,var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.stat-lbl{font-family:'Space Mono';font-size:9px;letter-spacing:2px;color:var(--dim);text-transform:uppercase;margin-top:4px}
section{padding:90px 48px;position:relative}
.sec-lbl{font-family:'Space Mono';font-size:10px;letter-spacing:4px;color:var(--cyan);text-transform:uppercase;margin-bottom:14px;display:flex;align-items:center;gap:12px}
.sec-lbl::after{content:'';flex:1;max-width:50px;height:1px;background:var(--cyan);opacity:.5}
.sec-title{font-family:'Bebas Neue';font-size:clamp(44px,6vw,72px);line-height:1;letter-spacing:1px}
/* FLIP CARDS */
.flip-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:50px}
.flip-card{perspective:1000px;cursor:pointer;min-height:300px}
.flip-inner{position:relative;width:100%;height:100%;min-height:300px;transform-style:preserve-3d;transition:transform .6s cubic-bezier(.4,0,.2,1)}
.flip-card.flipped .flip-inner{transform:rotateY(180deg)}
.flip-front,.flip-back{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.flip-front{background:linear-gradient(135deg,var(--mid) 0%,rgba(0,102,255,.08) 100%);border:1px solid rgba(0,102,255,.25);display:flex;flex-direction:column;justify-content:space-between;padding:28px 24px;position:relative;overflow:hidden}
.flip-front::before{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:linear-gradient(to bottom,var(--electric),var(--cyan))}
.f-num{font-family:'Bebas Neue';font-size:60px;line-height:1;color:rgba(0,102,255,.12);position:absolute;top:8px;right:16px}
.f-client{font-family:'Bebas Neue';font-size:26px;letter-spacing:1px;color:white;margin-bottom:4px}
.f-handle{font-family:'Space Mono';font-size:9px;letter-spacing:1px;color:var(--cyan);margin-bottom:12px}
.f-desc{font-size:12px;line-height:1.7;color:var(--dim);font-weight:300;flex:1}
.f-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:14px}
.f-tag{font-family:'Space Mono';font-size:8px;letter-spacing:1px;padding:3px 7px;border:1px solid rgba(0,212,255,.3);color:var(--glow);text-transform:uppercase}
.flip-btn{margin-top:16px;font-family:'Space Mono';font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--cyan);display:flex;align-items:center;gap:6px;border:none;background:none;cursor:pointer;padding:0}
.flip-btn::after{content:'→';transition:transform .2s}
.flip-card:hover .flip-btn::after{transform:translateX(4px)}
.flip-back{transform:rotateY(180deg);overflow:hidden;border:1px solid rgba(0,212,255,.3)}
.flip-back img{width:100%;height:100%;object-fit:cover;display:block}
.flip-back .img-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(3,13,26,.9) 0%,transparent 50%);display:flex;flex-direction:column;justify-content:flex-end;padding:20px}
.flip-back .img-overlay .ov-name{font-family:'Bebas Neue';font-size:22px;letter-spacing:1px}
.ov-close{position:absolute;top:12px;right:12px;width:28px;height:28px;border:1px solid rgba(0,212,255,.4);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--cyan);background:rgba(3,13,26,.7)}
.flip-back.no-img{transform:rotateY(180deg);display:flex;align-items:center;justify-content:center;background:var(--dark);border:1px solid rgba(0,212,255,.3)}
/* LOGOS */
.logos-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:44px}
.logo-flip{perspective:1000px;cursor:pointer;height:200px}
.logo-flip-inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .6s cubic-bezier(.4,0,.2,1)}
.logo-flip.flipped .logo-flip-inner{transform:rotateY(180deg)}
.logo-front,.logo-back-p{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.logo-front{background:linear-gradient(135deg,var(--mid),rgba(0,102,255,.08));border:1px solid rgba(0,102,255,.25);display:flex;flex-direction:column;justify-content:center;padding:22px 18px;position:relative;overflow:hidden}
.logo-front::before{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:linear-gradient(to bottom,var(--electric),var(--cyan))}
.lf-name{font-family:'Bebas Neue';font-size:20px;letter-spacing:1px;margin-bottom:5px}
.lf-type{font-family:'Space Mono';font-size:8px;letter-spacing:1px;color:var(--cyan);text-transform:uppercase;margin-bottom:9px}
.lf-desc{font-size:11px;line-height:1.6;color:var(--dim);font-weight:300}
.lf-hint{font-family:'Space Mono';font-size:8px;color:rgba(0,212,255,.4);margin-top:10px;letter-spacing:1px}
.logo-back-p{transform:rotateY(180deg);background:var(--dark);border:1px solid rgba(0,212,255,.3);display:flex;align-items:center;justify-content:center;padding:20px}
.logo-circle{width:140px;height:140px;border-radius:50%;overflow:hidden;border:2px solid rgba(0,212,255,.4);box-shadow:0 0 24px rgba(0,212,255,.2);background:white}
.logo-circle img{width:100%;height:100%;object-fit:cover}
/* ARQ SECTION */
.arq-section{background:linear-gradient(135deg,var(--dark) 0%,rgba(0,102,255,.08) 100%);border-top:1px solid rgba(0,102,255,.2);border-bottom:1px solid rgba(0,102,255,.2)}
.arq-inner{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.arq-geo-wrap{display:flex;justify-content:center;align-items:center;height:260px;position:relative}
.arq-geo{position:absolute;border:1px solid rgba(0,102,255,.3)}
.arq-g1{width:180px;height:180px;top:50%;left:50%;transform:translate(-50%,-50%) rotate(0deg);animation:rotG 20s linear infinite}
.arq-g2{width:120px;height:120px;top:50%;left:50%;transform:translate(-50%,-50%);border-color:rgba(0,212,255,.4);animation:rotG 14s linear infinite reverse}
.arq-g3{width:240px;height:240px;top:50%;left:50%;transform:translate(-50%,-50%);border-color:rgba(0,102,255,.15);animation:rotG 30s linear infinite}
.arq-dot{width:8px;height:8px;background:var(--cyan);border-radius:50%;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);box-shadow:0 0 20px var(--cyan),0 0 40px var(--electric)}
@keyframes rotG{to{transform:translate(-50%,-50%) rotate(360deg)}}
.arq-text h2{font-family:'Bebas Neue';font-size:clamp(32px,4vw,52px);line-height:1;margin-bottom:16px}
.arq-text p{font-size:14px;line-height:1.9;color:var(--dim);font-weight:300;margin-bottom:16px}
.arq-highlight{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border:1px solid rgba(0,212,255,.4);background:rgba(0,212,255,.06);font-family:'Bebas Neue';font-size:22px;letter-spacing:2px;color:var(--cyan);margin-bottom:16px}
.arq-skills{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}
/* SKILLS */
.skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:2px;margin-top:50px;border:1px solid rgba(0,102,255,.12)}
.skill-card{padding:28px 24px;background:var(--dark);border:1px solid transparent;position:relative;overflow:hidden;transition:background .3s,border-color .3s;cursor:none}
.skill-card::before{content:'';position:absolute;top:0;left:0;width:3px;height:0;background:linear-gradient(to bottom,var(--electric),var(--cyan));transition:height .4s ease}
.skill-card:hover{background:var(--mid);border-color:rgba(0,102,255,.3)}
.skill-card:hover::before{height:100%}
.sk-icon{font-size:26px;margin-bottom:12px;display:block}
.sk-name{font-family:'Bebas Neue';font-size:22px;letter-spacing:1px;margin-bottom:7px}
.sk-desc{font-size:12px;line-height:1.7;color:var(--dim);font-weight:300}
.sk-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:12px}
.tag{font-family:'Space Mono';font-size:8px;letter-spacing:1px;padding:2px 7px;border:1px solid rgba(0,102,255,.3);color:var(--glow);text-transform:uppercase}
.ciudad-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-top:50px}
.ciudad-card{padding:28px;border:1px solid rgba(0,102,255,.2);background:rgba(0,102,255,.04);transition:border-color .3s,transform .3s}
.ciudad-card:hover{border-color:var(--electric);transform:translateY(-4px)}
.ciudad-card.main{border-color:rgba(0,212,255,.4);background:rgba(0,212,255,.04)}
.c-name{font-family:'Bebas Neue';font-size:30px;letter-spacing:2px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px}
.c-badge{font-family:'Space Mono';font-size:7px;padding:2px 7px;background:var(--electric);color:white;letter-spacing:1px}
.c-desc{font-size:12px;line-height:1.7;color:var(--dim);font-weight:300}
.fl-inner{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:50px;align-items:center}
.fl-panel{padding:36px;background:linear-gradient(135deg,rgba(0,102,255,.12),rgba(0,212,255,.06));border:1px solid rgba(0,212,255,.3)}
.fl-panel h3{font-family:'Bebas Neue';font-size:28px;letter-spacing:1px;color:var(--cyan);margin-bottom:14px}
.fl-panel p{font-size:13px;line-height:1.8;color:var(--dim);font-weight:300;margin-bottom:16px}
.fl-list{list-style:none;display:flex;flex-direction:column;gap:9px}
.fl-list li{font-family:'Space Mono';font-size:10px;color:var(--glow);display:flex;align-items:center;gap:10px}
.fl-list li::before{content:'▸';color:var(--cyan)}
.contact-section{background:var(--dark);text-align:center}
.contact-section .sec-lbl{justify-content:center}
.contact-section .sec-lbl::after{display:none}
.contact-section .sec-lbl::before{content:'';max-width:50px;height:1px;background:var(--cyan);opacity:.5}
.contact-sub{font-size:16px;color:var(--dim);font-weight:300;max-width:440px;margin:14px auto 40px;line-height:1.7}
.contact-links{display:flex;justify-content:center;gap:14px;flex-wrap:wrap}
.contact-link{display:flex;align-items:center;gap:8px;padding:14px 24px;border:1px solid rgba(0,102,255,.3);color:var(--dim);text-decoration:none;font-family:'Space Mono';font-size:10px;letter-spacing:1px;transition:all .3s;background:rgba(0,102,255,.04);cursor:none}
.contact-link:hover{border-color:var(--cyan);color:var(--cyan);background:rgba(0,212,255,.06);transform:translateY(-2px)}
.divider{width:100%;height:1px;background:linear-gradient(90deg,transparent,rgba(0,102,255,.3),transparent)}
footer{padding:28px 48px;display:flex;justify-content:space-between;align-items:center;border-top:1px solid rgba(0,102,255,.15);flex-wrap:wrap;gap:14px}
footer p{font-family:'Space Mono';font-size:9px;letter-spacing:1px;color:rgba(240,246,255,.3)}
.footer-logo{font-family:'Bebas Neue';font-size:16px;letter-spacing:3px;color:rgba(0,102,255,.4)}
.reveal{opacity:0;transform:translateY(36px);transition:opacity .7s ease,transform .7s ease}
.reveal.visible{opacity:1;transform:translateY(0)}
.touch-hint{font-family:'Space Mono';font-size:10px;letter-spacing:2px;color:rgba(0,212,255,.4);margin-top:16px;display:flex;align-items:center;gap:8px}
@media(max-width:900px){
  .hero{grid-template-columns:1fr;padding:100px 24px 60px}
  .photo-wrap{order:-1}.photo-frame{max-width:260px}
  nav{padding:18px 24px}.nav-links{display:none}
  section{padding:60px 24px}
  .flip-grid{grid-template-columns:1fr 1fr}
  .logos-grid{grid-template-columns:1fr 1fr}
  .ciudad-grid{grid-template-columns:1fr}
  .fl-inner{grid-template-columns:1fr}
  .arq-inner{grid-template-columns:1fr}
  .arq-geo-wrap{display:none}
  .stats{padding:28px 24px}
  footer{flex-direction:column;text-align:center;padding:20px}
}
@media(max-width:500px){.flip-grid{grid-template-columns:1fr}.logos-grid{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="ring"></div>
<nav>
  <div class="nav-logo">SANTIAGO DÍAZ</div>
  <div class="nav-links">
    <a href="#trabajo">Trabajo</a><a href="#logos">Logos</a>
    <a href="#arquitectura">Arquitectura</a><a href="#habilidades">Habilidades</a>
    <a href="#contacto">Contacto</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="orb orb1"></div><div class="orb orb2"></div>
  <div class="hero-content">
    <div class="hero-tag">Community Manager · Creativo Digital · Venezuela</div>
    <h1 class="hero-name">SANTIAGO<br>DÍAZ</h1>
    <p class="hero-sub"><span>Community Manager</span> &amp; Creativo Digital 360°</p>
    <p class="hero-desc">No solo gestiono redes. Produzco, grabo, edito, fotografío y diseño. Soy un equipo completo en una sola persona: desde el concepto hasta la publicación.</p>
    <div class="arq-badge">
      <span class="arq-badge-icon">🏛️</span>
      <div class="arq-badge-text">
        <strong>8vo Semestre · Arquitectura</strong>
        Visión estructural aplicada al diseño digital
      </div>
    </div>
    <div class="hero-ctas">
      <a href="#trabajo" class="btn-p">Ver mi trabajo</a>
      <a href="#contacto" class="btn-o">Hablemos</a>
    </div>
